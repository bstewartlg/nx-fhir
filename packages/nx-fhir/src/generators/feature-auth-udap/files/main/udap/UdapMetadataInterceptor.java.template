package <%= packageBase %>.udap;

import ca.uhn.fhir.interceptor.api.Hook;
import ca.uhn.fhir.interceptor.api.Interceptor;
import ca.uhn.fhir.interceptor.api.Pointcut;
import com.fasterxml.jackson.databind.ObjectMapper;
import jakarta.servlet.http.HttpServletRequest;
import jakarta.servlet.http.HttpServletResponse;
import java.io.IOException;
import java.util.Map;
import org.slf4j.Logger;
import org.slf4j.LoggerFactory;

/**
 * Answers GET {baseURL}/.well-known/udap with the UDAP metadata and ends the request. The answer does not depend on
 * the query string, so each community value gets the same metadata. Each other request goes on to HAPI.
 */
@Interceptor
public class UdapMetadataInterceptor {

	private static final Logger log = LoggerFactory.getLogger(UdapMetadataInterceptor.class);
	private static final ObjectMapper JSON = new ObjectMapper();
	private static final String PATH = "/.well-known/udap";

	private final UdapMetadata metadata;

	public UdapMetadataInterceptor(UdapMetadata metadata) {
		this.metadata = metadata;
	}

	@Hook(Pointcut.SERVER_INCOMING_REQUEST_PRE_PROCESSED)
	public boolean serve(HttpServletRequest request, HttpServletResponse response) throws IOException {
		if (!"GET".equals(request.getMethod()) || !PATH.equals(request.getPathInfo())) {
			return true;
		}
		Map<String, Object> body;
		try {
			body = metadata.build();
		} catch (RuntimeException e) {
			log.error("Could not build the UDAP metadata", e);
			response.setStatus(HttpServletResponse.SC_SERVICE_UNAVAILABLE);
			return false;
		}
		response.setStatus(HttpServletResponse.SC_OK);
		response.setContentType("application/json");
		JSON.writeValue(response.getOutputStream(), body);
		return false;
	}
}
