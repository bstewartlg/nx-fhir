package <%= packageBase %>.auth;

import ca.uhn.fhir.rest.server.RestfulServer;
import jakarta.annotation.PostConstruct;
import jakarta.annotation.PreDestroy;
import java.util.List;
import org.apache.commons.lang3.StringUtils;
import org.slf4j.Logger;
import org.slf4j.LoggerFactory;
import org.springframework.stereotype.Component;

/**
 * Registers the bearer token check on the FHIR server when app.auth.enabled is true, and closes its key sources
 * at shutdown. With app.auth.enabled true, an empty app.auth.issuers or an entry with no issuer stops the
 * application at startup.
 */
@Component
public class AuthResourceConfig {

	private static final Logger log = LoggerFactory.getLogger(AuthResourceConfig.class);

	private final RestfulServer restfulServer;
	private final AuthResourceProperties properties;
	private BearerTokenInterceptor interceptor;

	public AuthResourceConfig(RestfulServer restfulServer, AuthResourceProperties properties) {
		this.restfulServer = restfulServer;
		this.properties = properties;
	}

	@PostConstruct
	public void register() {
		if (!properties.isEnabled()) {
			return;
		}
		if (properties.getIssuers().isEmpty()) {
			throw new IllegalStateException("app.auth.enabled is true and app.auth.issuers has no entry");
		}
		// A null entry gets the same startup error from the interceptor as an entry with no issuer.
		List<BearerTokenInterceptor.Issuer> issuers = properties.getIssuers().stream()
				.map(entry -> entry == null
						? new BearerTokenInterceptor.Issuer(null, null, null)
						: new BearerTokenInterceptor.Issuer(entry.getIssuer(), entry.getAudience(), entry.getJwksUri()))
				.toList();
		String bypassHeader = properties.getBypassHeader();
		if (StringUtils.isNotBlank(bypassHeader)) {
			log.warn("app.auth.bypass-header is set, so each FHIR request with the header {} skips the bearer token check",
					bypassHeader);
		}
		interceptor = new BearerTokenInterceptor(issuers, properties.getPublicEndpoints(), bypassHeader);
		restfulServer.registerInterceptor(interceptor);
	}

	@PreDestroy
	public void close() {
		if (interceptor != null) {
			interceptor.close();
		}
	}
}
