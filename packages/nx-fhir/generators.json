{
  "generators": {
    "server": {
      "factory": "./src/generators/server/server",
      "schema": "./src/generators/server/schema.json",
      "description": "server generator"
    },
    "import-server": {
      "factory": "./src/generators/import-server/import-server",
      "schema": "./src/generators/import-server/schema.json",
      "description": "Import an existing HAPI FHIR server as an Nx project"
    },
    "operation": {
      "factory": "./src/generators/operation/operation",
      "schema": "./src/generators/operation/schema.json",
      "description": "operation generator"
    },
    "implementation-guide": {
      "factory": "./src/generators/implementation-guide/implementation-guide",
      "schema": "./src/generators/implementation-guide/schema.json",
      "description": "implementation-guide generator",
      "aliases": ["ig"]
    },
    "feature": {
      "factory": "./src/generators/feature/feature",
      "schema": "./src/generators/feature/schema.json",
      "description": "Add a packaged feature to an existing server project"
    },
    "feature-bulk-publish": {
      "factory": "./src/generators/feature-bulk-publish/feature-bulk-publish",
      "schema": "./src/generators/feature-bulk-publish/schema.json",
      "description": "Add $bulk-publish bulk data publication to an existing server project"
    },
    "preset": {
      "factory": "./src/generators/preset/generator",
      "schema": "./src/generators/preset/schema.json",
      "description": "preset generator",
      "x-use-standalone-layout": true
    },
    "frontend": {
      "factory": "./src/generators/frontend/frontend",
      "schema": "./src/generators/frontend/schema.json",
      "description": "frontend generator"
    },
    "update-server": {
      "factory": "./src/generators/update-server/update-server",
      "schema": "./src/generators/update-server/schema.json",
      "description": "update-server generator"
    },
    "update-frontend": {
      "factory": "./src/generators/update-frontend/update-frontend",
      "schema": "./src/generators/update-frontend/schema.json",
      "description": "Update a FHIR frontend project to a newer template version"
    },
    "update": {
      "factory": "./src/generators/update/update",
      "schema": "./src/generators/update/schema.json",
      "description": "Update nx-fhir plugin and check for server updates"
    }
  }
}
